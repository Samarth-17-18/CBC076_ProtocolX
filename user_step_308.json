  "ReplacementContent": "<script>\nconst $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];\nconst API_BASE = window.location.origin.includes('8000') ? '' : 'http://127.0.0.1:8000';\nlet user=null,reg=false,t0,cur=null;\nlet reps=[];\n\nfunction go(v){\n  if(!user&&v!=='login'&&v!=='status')v='login';\n  $$('.view').forEach(e=>e.classList.toggle('on',e.id==='v-'+v));\n  $$('#nav button').forEach(b=>b.classList.toggle('on',b.dataset.v===v));\n  document.body.classList.toggle('auth',!user);scrollTo({top:0,behavior:'smooth'});\n  if(v==='work'||v==='hist')fetchReports();\n}\n$$('#nav button').forEach(b=>b.onclick=()=>go(b.dataset.v));\n\nfunction toast(m){\n  const t=$('#toast');t.textContent=m;t.classList.add('on');\n  clearTimeout(t0);t0=setTimeout(()=>t.classList.remove('on'),2600);\n}\n\nfunction mode(){\n  reg=!reg;\n  $('#nm').style.display=reg?'block':'none';\n  $('#lt').textContent=reg?'Make an account':'Hey, welcome back';\n  $('#ls').textContent=reg?'takes ten seconds':'sign in to your workspace';\n  $('#lb').textContent=reg?'Create it \u2192':'Let me in \u2192';\n  $('#sw').textContent=reg?'Have an account? Sign in':'New here? Create account';\n}\n\nfunction login(e){\n  if(e)e.preventDefault();\n  try{\n    const em=$('#em').value.trim(),pw=$('#pw').value,er=$('#le'),f=$('#lf'),nm=$('#nme').value.trim();\n    if(!em||!pw||(reg&&!nm)){\n      er.textContent=reg&&!nm?'Add your name first.':'Type an email and a password, or tap \"Try the demo\".';\n      f.classList.remove('shake');void f.offsetWidth;f.classList.add('shake');\n      return false;\n    }\n    enter(nm||em.split('@')[0]);\n  }catch(x){enter('Student')}\n  return false;\n}\n\nfunction enter(n){\n  user=(n||'Student');user=user[0].toUpperCase()+user.slice(1);\n  $('#le').textContent='';$('#av').textContent=user[0];\n  $('#hi').innerHTML='Hi '+user+'. Drop a <mark>draft.</mark>';\n  toast('Signed in as '+user);\n  go('work');\n}\n\nasync function fetchReports(){\n  try {\n    const res = await fetch(`${API_BASE}/api/reports`);\n    if(res.ok){\n      const data = await res.json();\n      reps = data.map(r=>({\n        id: 'SYN-' + r.id,\n        raw_id: r.id,\n        name: r.doc_a_title || 'Untitled Draft',\n        v: Math.round(r.exact_similarity || 0),\n        p: Math.round(r.semantic_similarity || 0),\n        c: 4,\n        total: Math.round(r.overall_similarity || 0),\n        d: r.created_at ? r.created_at.slice(0, 16) : 'recently',\n        explanation: r.explanation || '',\n        evidence: r.evidence || []\n      }));\n    }\n  } catch(e) {\n    console.warn('Backend unavailable, using local cache:', e);\n  }\n  list();\n}\n\nfunction list(){\n  const row=r=>`<div class=\"hist\" onclick=\"open_('${r.id}')\"><div class=\"sc\" style=\"background:${r.total>20?'var(--pink)':'var(--acid)'}\">${r.total}%</div><div style=\"flex:1\"><b>${r.name}</b><br><span class=\"mono\">${r.id} \u00b7 ${r.d}</span></div><span class=\"chip\">view \u2192</span></div>`;\n  const recentItems = reps.slice(0,3);\n  $('#recent').innerHTML=recentItems.length ? `<div class=\"card\">${recentItems.map(row).join('')}</div>` : '<div class=\"card\"><p class=\"mono\">No reports yet. Drop a file above to run your first scan.</p></div>';\n  $('#all').innerHTML=reps.length ? reps.map(row).join('') : '<p class=\"mono\" style=\"padding:20px\">No reports in history.</p>';\n}\n\nasync function open_(id){\n  cur = reps.find(r=>r.id===id);\n  if(!cur) return;\n  $('#rid').textContent=cur.id;\n  $('#rt').textContent=cur.name;\n  \n  // Try fetching detailed report with full text and evidence\n  if(cur.raw_id){\n    try {\n      const res = await fetch(`${API_BASE}/api/reports/${cur.raw_id}`);\n      if(res.ok){\n        const det = await res.json();\n        cur.doc_a_text = det.doc_a_text;\n        cur.doc_b_title = det.doc_b_title;\n        cur.evidence = det.evidence || [];\n      }\n    } catch(e) {\n      console.warn('Error fetching report details:', e);\n    }\n  }\n  \n  draw();\n  go('rep');\n}\n\nfunction draw(){\n  const xc=$('#xc').classList.contains('on'),xq=$('#xq').classList.contains('on');\n  const a=cur.v,b=cur.p,c=xc||xq?0:cur.c,t=cur.total || (a+b+c);\n  $('#ring').style.setProperty('--p',t);$('#rv').textContent=t+'%';\n  $('#rs').textContent=t<15?'Looks mostly original. Passages pass integrity guidelines.':(cur.explanation || 'Significant overlap detected. Review highlighted passages.');\n  $('#pa').textContent=a+'% exact overlap';$('#pb2').textContent=b+'% semantic similarity';$('#pc2').textContent=(xc||xq)?'excluded':cur.c+'% citations';\n  \n  // Render dynamic doc text and evidence if available\n  if(cur.evidence && cur.evidence.length > 0){\n    let docHtml = cur.doc_a_text ? cur.doc_a_text.slice(0, 1000) : '';\n    let srcHtml = '';\n    \n    cur.evidence.slice(0, 3).forEach((ev, idx)=>{\n      const tag = idx === 0 ? 'a' : (idx === 1 ? 'b' : 'c');\n      const sent = ev.sentence_a || '';\n      if(sent && docHtml.includes(sent)){\n        docHtml = docHtml.replace(sent, `<span class=\"hl ${tag}\" data-s=\"${tag}\">${sent}</span>`);\n      } else if (!docHtml) {\n        docHtml += `<span class=\"hl ${tag}\" data-s=\"${tag}\">${sent}</span> `;\n      }\n      \n      const typeLabel = ev.type || 'Match';\n      const reasonLabel = ev.reason || 'Similarity detected';\n      srcHtml += `<div class=\"s ${tag}\" data-s=\"${tag}\"><span class=\"mono\">${typeLabel} \u00b7 ${cur.doc_b_title || 'Corpus Reference'}</span><br><b>${reasonLabel}</b><div class=\"mono\">${ev.score || 0}% match score</div></div>`;\n    });\n    \n    if(docHtml) $('.card.doc').innerHTML = docHtml;\n    srcHtml += `<button class=\"btn acid\" style=\"width:100%\" onclick=\"toast('Report exported to PDF')\">Export PDF</button>`;\n    $('.srcs').innerHTML = srcHtml;\n  }\n  \n  $$('.hl[data-s=c]').forEach(h=>h.classList.toggle('off',xc||xq));\n  $$('.s[data-s=c]').forEach(h=>h.classList.toggle('dim',xc||xq));\n  \n  $$('.hl,.s').forEach(el=>el.onclick=()=>{\n    const k=el.dataset.s;\n    $$('.s').forEach(s=>s.classList.toggle('on',s.dataset.s===k));\n  });\n}\n\n['xc','xq'].forEach(i=>$('#'+i).onclick=e=>{e.target.classList.toggle('on');draw()});\n\nconst drop=$('#drop'),file=$('#file');\ndrop.onclick=()=>file.click();\n['dragover','dragenter'].forEach(n=>drop.addEventListener(n,e=>{e.preventDefault();drop.classList.add('over')}));\n['dragleave','drop'].forEach(n=>drop.addEventListener(n,e=>{e.preventDefault();drop.classList.remove('over')}));\ndrop.addEventListener('drop',e=>e.dataTransfer.files[0]&&upload(e.dataTransfer.files[0]));\nfile.onchange=()=>file.files[0]&&upload(file.files[0]);\n\nasync function upload(f){\n  $('#up').style.display='block';$('#fn').textContent=f.name;\n  let p=10;\n  $('#pb').style.width=p+'%';$('#pc').textContent=p+'%';$('#ps').textContent='uploading\u2026';\n  \n  const formData = new FormData();\n  formData.append('file', f);\n  formData.append('title', f.name);\n  formData.append('author', user || 'Student');\n\n  const progressInterval = setInterval(()=>{\n    if(p < 85){\n      p += Math.round(5 + Math.random() * 8);\n      $('#pb').style.width=Math.min(85, p)+'%';\n      $('#pc').textContent=Math.min(85, p)+'%';\n      if(p > 35 && p < 65) $('#ps').textContent='reading your passages\u2026';\n      if(p >= 65) $('#ps').textContent='comparing with ProtocolX ML model\u2026';\n    }\n  }, 200);\n\n  try {\n    const response = await fetch(`${API_BASE}/api/upload`, {\n      method: 'POST',\n      body: formData\n    });\n    \n    clearInterval(progressInterval);\n    $('#pb').style.width='100%';$('#pc').textContent='100%';$('#ps').textContent='done';\n    \n    if(response.ok){\n      const data = await response.json();\n      toast('Document processed & scanned!');\n      await fetchReports();\n      setTimeout(()=>{\n        $('#up').style.display='none';\n        if(data.report_id){\n          open_('SYN-' + data.report_id);\n        } else if(reps[0]) {\n          open_(reps[0].id);\n        }\n      }, 500);\n    } else {\n      toast('Upload failed: ' + response.statusText);\n      $('#up').style.display='none';\n    }\n  } catch(err) {\n    clearInterval(progressInterval);\n    console.error('Upload error:', err);\n    toast('Error connecting to backend API');\n    $('#up').style.display='none';\n  }\n}\n\nfunction state(k){\n  const m={\n    error:['Scan hit a snag.','Something timed out on our side. Your file is safe. Try again.','Retry','work','!','var(--pink)'],\n    out:['See you soon.','You are signed out. Your reports are saved.','Sign in again','login','\u263a','var(--sky)']\n  }[k];\n  if(k==='out'){user=null;}\n  $('#st').textContent=m[0];$('#sd').textContent=m[1];$('#sb').textContent=m[2];$('#sb').onclick=()=>go(m[3]);\n  $('#sf').textContent=m[4];$('#sf').style.background=m[5];\n  go('status');\n  $$('#nav button').forEach(b=>b.classList.remove('on'));\n}\n\ngo('login');\n</script>",
