  "TargetContent": "<script>\nconst $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];\nlet user=null,reg=false,t0,cur=null;\nlet reps=[{id:'SYN-4102',name:'Thesis chapter 3.docx',v:9,p:6,c:5,d:'2 days ago'},{id:'SYN-3977',name:'Lit review.pdf',v:21,p:14,c:6,d:'last week'},{id:'SYN-3815',name:'Essay draft.txt',v:2,p:3,c:1,d:'3 weeks ago'}];\nconst score=r=>r.v+r.p+(+!$('#xc')?0:0)+(r.c&&!$('#xc').classList.contains('on')?r.c:0);\nfunction go(v){\n  if(!user&&v!=='login'&&v!=='status')v='login';\n  $$('.view').forEach(e=>e.classList.toggle('on',e.id==='v-'+v));\n  $$('#nav button').forEach(b=>b.classList.toggle('on',b.dataset.v===v));\n  document.body.classList.toggle('auth',!user);scrollTo({top:0,behavior:'smooth'});\n  if(v==='work'||v==='hist')list()}\n$$('#nav button').forEach(b=>b.onclick=()=>go(b.dataset.v));\nfunction toast(m){const t=$('#toast');t.textContent=m;t.classList.add('on');clearTimeout(t0);t0=setTimeout(()=>t.classList.remove('on'),2600)}\nfunction mode(){reg=!reg;$('#nm').style.display=reg?'block':'none';$('#lt').textContent=reg?'Make an account':'Hey, welcome back';$('#ls').textContent=reg?'takes ten seconds':'sign in to your workspace';$('#lb').textContent=reg?'Create it \u2192':'Let me in \u2192';$('#sw').textContent=reg?'Have an account? Sign in':'New here? Create account'}\nfunction login(e){if(e)e.preventDefault();\n  try{const em=$('#em').value.trim(),pw=$('#pw').value,er=$('#le'),f=$('#lf'),nm=$('#nme').value.trim();\n  if(!em||!pw||(reg&&!nm)){er.textContent=reg&&!nm?'Add your name first.':'Type an email and a password (anything works), or tap \"Try the demo\".';f.classList.remove('shake');void f.offsetWidth;f.classList.add('shake');return false}\n  enter(nm||em.split('@')[0])}catch(x){enter('Guest')}return false}\nfunction enter(n){user=(n||'Guest');user=user[0].toUpperCase()+user.slice(1);\n  $('#le').textContent='';$('#av').textContent=user[0];$('#hi').innerHTML='Hi '+user+'. Drop a <mark>draft.</mark>';toast('Signed in');go('work')}\nfunction list(){\n  const row=r=>`<div class=\"hist\" onclick=\"open_('${r.id}')\"><div class=\"sc\" style=\"background:${r.v+r.p>20?'var(--pink)':'var(--acid)'}\">${r.v+r.p}%</div><div style=\"flex:1\"><b>${r.name}</b><br><span class=\"mono\">${r.id} \u00b7 ${r.d}</span></div><span class=\"chip\">view \u2192</span></div>`;\n  $('#recent').innerHTML=`<div class=\"card\">${reps.slice(0,3).map(row).join('')}</div>`;$('#all').innerHTML=reps.map(row).join('')}\nfunction open_(id){cur=reps.find(r=>r.id===id);$('#rid').textContent=cur.id;$('#rt').textContent=cur.name;draw();go('rep')}\nfunction draw(){\n  const xc=$('#xc').classList.contains('on'),xq=$('#xq').classList.contains('on');\n  const a=cur.v,b=cur.p,c=xc||xq?0:cur.c,t=a+b+c;\n  $('#ring').style.setProperty('--p',t);$('#rv').textContent=t+'%';\n  $('#rs').textContent=t<15?'Looks mostly original. Two passages worth rewording.':'Quite a lot overlaps. Start with the pink one.';\n  $('#pa').textContent=a+'% of your text';$('#pb2').textContent=b+'% of your text';$('#pc2').textContent=(xc||xq)?'excluded':cur.c+'% of your text';\n  $$('.hl[data-s=c]').forEach(h=>h.classList.toggle('off',xc||xq));$$('.s[data-s=c]').forEach(h=>h.classList.toggle('dim',xc||xq))}\n['xc','xq'].forEach(i=>$('#'+i).onclick=e=>{e.target.classList.toggle('on');draw()});\n$$('.hl,.s').forEach(el=>el.onclick=()=>{const k=el.dataset.s;$$('.s').forEach(s=>s.classList.toggle('on',s.dataset.s===k))});\nconst drop=$('#drop'),file=$('#file');\ndrop.onclick=()=>file.click();\n['dragover','dragenter'].forEach(n=>drop.addEventListener(n,e=>{e.preventDefault();drop.classList.add('over')}));\n['dragleave','drop'].forEach(n=>drop.addEventListener(n,e=>{e.preventDefault();drop.classList.remove('over')}));\ndrop.addEventListener('drop',e=>e.dataTransfer.files[0]&&upload(e.dataTransfer.files[0]));\nfile.onchange=()=>file.files[0]&&upload(file.files[0]);\nfunction upload(f){\n  $('#up').style.display='block';$('#fn').textContent=f.name;\n  let p=0;const st=[[30,'uploading\u2026'],[60,'reading your passages\u2026'],[90,'comparing against sources\u2026'],[100,'done']];\n  const iv=setInterval(()=>{p=Math.min(100,p+3+Math.random()*5);\n    $('#pb').style.width=p+'%';$('#pc').textContent=Math.round(p)+'%';$('#ps').textContent=st.find(s=>p<=s[0])[1];\n    if(p===100){clearInterval(iv);\n      const r={id:'SYN-'+Math.floor(4200+Math.random()*800),name:f.name,v:Math.round(4+Math.random()*10),p:Math.round(3+Math.random()*8),c:Math.round(2+Math.random()*5),d:'just now'};\n      reps.unshift(r);setTimeout(()=>{$('#up').style.display='none';open_(r.id)},400)}},120)}\nfunction state(k){\n  const m={error:['Scan hit a snag.','Something timed out on our side. Your file is safe. Try again.','Retry','work','!','var(--pink)'],\n  out:['See you soon.','You are signed out. Your reports are saved.','Sign in again','login','\u263a','var(--sky)']}[k];\n  if(k==='out'){user=null}\n  $('#st').textContent=m[0];$('#sd').textContent=m[1];$('#sb').textContent=m[2];$('#sb').onclick=()=>go(m[3]);\n  $('#sf').textContent=m[4];$('#sf').style.background=m[5];go('status');$$('#nav button').forEach(b=>b.classList.remove('on'))}\ngo('login');\n</script>",
